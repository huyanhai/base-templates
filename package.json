{
  "name": "base",
  "version": "0.0.1",
  "packageManager": "pnpm@7.1.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "rm": "rm -rf node_modules **/*/node_modules",
    "lint": "Diff=$(git diff --diff-filter=d --cached --name-only -- '*.js' '*.ts' '*.tsx' '*.vue') && eslint --fix $Diff",
    "gen": "bash scripts/gen-pkg.sh",
    "clean:dist": "pnpm run -r --parallel clean:dist",
    "build": "pnpm run -r --parallel build",
    "pkg": "bash scripts/run-pkg.sh"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "sass": "^1.89.2",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "dayjs": "^1.11.13",
    "nprogress": "^0.2.0"
  },
  "lint-staged": {
    "*.{less,sass}": [
      "stylelint --config  ./.stylelintrc --fix"
    ],
    "*.{ts,js,tsx}": [
      "npm run lint",
      "prettier --write"
    ]
  }
}
