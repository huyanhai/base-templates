{
    "name": "micro-app",
    "version": "0.0.1",
    "packageManager": "pnpm@10.13.1",
    "description": "",
    "main": "index.js",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "prepare": "husky install",
        "rm": "rm -rf node_modules **/*/node_modules",
        "lint": "Diff=$(git diff --diff-filter=d --cached --name-only -- '*.js' '*.ts' '*.tsx' '*.vue') && eslint --fix $Diff",
        "gen": "bash scripts/gen-pkg.sh",
        "clean:dist": "pnpm run -r --parallel clean:dist",
        "dev": "pnpm run -r --parallel  dev",
        "main:dev": "pnpm -F main dev",
        "child:dev": "pnpm -F child dev",
        "build": "pnpm run -r --parallel build && pnpm run move",
        "move": "node scripts/moveFile.js",
        "preview": "pnpm run -r --parallel preview",
        "pkg": "bash scripts/run-pkg.sh"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@rollup/plugin-babel": "^6.0.4",
        "@types/node": "^24.0.3",
        "@types/nprogress": "^0.2.3",
        "@types/path-browserify": "^1.0.3",
        "@types/qs": "^6.14.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "animate.css": "^4.1.1",
        "autoprefixer": "^10.4.21",
        "default-passive-events": "^4.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.5.0",
        "fs-extra": "^11.3.0",
        "globals": "^16.2.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "postcss": "^8.5.6",
        "prettier": "^3.5.3",
        "rollup-plugin-external-globals": "^0.13.0",
        "sass": "^1.89.2",
        "stylelint": "^16.21.0",
        "stylelint-config-standard": "^38.0.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.34.1",
        "unocss": "^66.3.3",
        "unplugin-auto-import": "^19.3.0",
        "unplugin-vue-components": "^28.8.0",
        "vite": "^7.0.5",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-qiankun": "^1.0.15",
        "vue-tsc": "^3.0.3"
    },
    "dependencies": {
        "@ant-design/icons-vue": "^7.0.1",
        "@micro-app/main": "workspace:^",
        "@micro-app/micro": "workspace:*",
        "@micro-app/utils": "workspace:^",
        "@stomp/stompjs": "^7.1.1",
        "@vueuse/core": "^13.5.0",
        "ant-design-vue": "^4.2.6",
        "axios": "^1.10.0",
        "change-case": "^5.4.4",
        "dayjs": "^1.11.13",
        "element-plus": "^2.10.4",
        "nprogress": "^0.2.0",
        "path-browserify": "^1.0.1",
        "pinia": "^3.0.3",
        "pinia-plugin-persistedstate": "^4.4.1",
        "qa": "^0.1.0",
        "qiankun": "^2.10.16",
        "qs": "^6.14.0",
        "vue-i18n": "^11.1.10",
        "vue-router": "^4.5.1"
    },
    "engines": {
        "node": "22.17.1",
        "pnpm": "10.13.1"
    },
    "lint-staged": {
        "*.{less,sass}": [
            "stylelint --config  ./.stylelintrc --fix"
        ],
        "*.{ts,js,tsx}": [
            "npm run lint",
            "prettier --write"
        ]
    }
}
