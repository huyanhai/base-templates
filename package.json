{
  "name": "base-templates",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare": "husky install",
    "plop": "plop --plopfile ./plop/index.js",
    "lint": "Diff=$(git diff --diff-filter=d --cached --name-only -- src/**/*[.js,.ts,.tsx,.vue]) && eslint --fix $Diff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyanhai/base-templates.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/huyanhai/base-templates/issues"
  },
  "homepage": "https://github.com/huyanhai/base-templates#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.29.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "change-case": "^5.4.4",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "plop": "^4.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "rollup-plugin-external-globals": "^0.13.0",
    "sass": "^1.89.2",
    "semver": "^7.7.2",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^2.2.10"
  },
  "lint-staged": {
    "*.{less,scss}": [
